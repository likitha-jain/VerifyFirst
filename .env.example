# Required in production: generate a long random secret and keep it server-side.
SCAMMAP_ADMIN_TOKEN=replace-with-at-least-32-random-bytes

# Exact browser origins allowed to call the API. No wildcard origins.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Production defaults. Demo mode is intentionally disabled.
DEMO_MODE=0
ALLOW_DEMO_LICENSE_ISSUE=0

# Use only if a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=0

SCAMMAP_DATA_DIR=./data
SCAMMAP_LICENSE_FILE=./data/license.json
# Set SCAMMAP_PRIVATE_KEY only on a protected license-issuer machine, never in a public app deployment.
# SCAMMAP_PRIVATE_KEY=/secure/path/license_private_key.pem

# Optional: server-side VirusTotal URL reputation checks. Never expose this in frontend code.
VT_API_KEY=

# CARTO Dark Matter basemap key. This key is delivered to the browser for tile requests;
# use a public/client key restricted to your hosted domain in the CARTO dashboard.
CARTO_API_KEY=

# OFF by default. Enable only for the isolated hackathon judging deployment.
# This makes /reports honour judge-supplied reporter_id/ip_prefix and allows
# unauthenticated POST /admin/reset as required by the judging harness.
# Never enable on an unrestricted public deployment.
JUDGE_API_COMPAT=0
